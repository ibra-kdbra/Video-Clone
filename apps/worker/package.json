{
  "name": "@grand/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Grand LMS background worker: moves outbox events into BullMQ, sends email, cleans up expired rows.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test scripts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@grand/contracts": "^0.1.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^6.3.10",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.13",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.12",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
