{
  "name": "@grand/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/database/migrate.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@grand/contracts": "0.1.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-fastify": "^12.1.1",
    "@nestjs/platform-socket.io": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/websockets": "^12.1.1",
    "@node-rs/argon2": "^2.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/core": "^1.16.12",
    "@types/node": "^22.19.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  },
  "description": "Grand LMS API: NestJS on Fastify, PostgreSQL with row-level security, Redis, Socket.IO."
}
