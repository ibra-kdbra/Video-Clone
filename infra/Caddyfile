# HTTPS for the API, the video store and LiveKit, with automatic Let's Encrypt certificates. Caddy
# passes the client's address on in X-Forwarded-For, and WebSockets through as they are.
{
	# LIVE_DOMAIN falls back to a local name, which gets a certificate from Caddy's own authority;
	# there's no system trust store to add it to in the container.
	skip_install_trust
}

{$API_DOMAIN} {
	encode zstd gzip

	# Only the API lives here.
	@api path /api/v1/*
	handle @api {
		reverse_proxy api:3000 {
			health_uri /api/v1/health/live
			health_interval 30s
		}
	}
	handle {
		respond "Not found" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Garage's S3 API, where browsers upload videos and fetch segments, posters and storyboards. The
# bucket is private: every request carries a signature made for this host name, which Caddy
# passes on unchanged. Garage itself answers CORS (npm run storage:setup).
{$MEDIA_DOMAIN} {
	reverse_proxy garage:3900

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output stdout
		format json
	}
}

# LiveKit's signal connection (a WebSocket) for live classes, when it runs (`--profile live`). The
# audio and video go straight to LiveKit on 7881/tcp and 7882/udp. Without LIVE_DOMAIN this block
# answers only to live.localhost, and nothing reaches it.
{$LIVE_DOMAIN:live.localhost} {
	reverse_proxy livekit:7880

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}
