# Production settings for infra/docker-compose.prod.yml. Copy to infra/.env.prod on the server and
# fill in every value. Generate secrets with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-40

# The API's public name, pointed at this server (a free DuckDNS name works).
API_DOMAIN=grand-lms.duckdns.org
# Where browsers fetch videos: a second name for this server. A DuckDNS name covers its
# subdomains, so media.<name>.duckdns.org needs no extra setup.
MEDIA_DOMAIN=media.grand-lms.duckdns.org

POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Garage, the video store. Both: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# The key the API and worker use. The ID is GK and 24 hex characters: echo GK$(openssl rand -hex 12)
# The secret: openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The Netlify site (and any custom domain), comma-separated.
WEB_ORIGINS=https://grand-lms.netlify.app
PUBLIC_WEB_URL=https://grand-lms.netlify.app

# Any SMTP provider. Free: Brevo (smtp://LOGIN:KEY@smtp-relay.brevo.com:587) or Resend.
SMTP_URL=
MAIL_FROM=Grand LMS <no-reply@example.com>
