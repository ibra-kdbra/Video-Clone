# Server-side keys. They are read by the /api function (and by `npm run dev`), never bundled into
# the browser code, so they must NOT start with VITE_. Both are free and need no credit card.
# On Netlify, set them under Site configuration > Environment variables instead of in a file.

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials).
# Restrict it to "YouTube Data API v3". Without it, the feed shows Dailymotion videos instead.
YOUTUBE_API_KEY=

# Twitch app from https://dev.twitch.tv/console (optional: without it Twitch results are skipped).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# No keys at hand? `npm run dev:mock` serves a local stand-in of the APIs instead.
