# Grand LMS settings for local development. Copy to .env (never commit it). Every app reads this
# one file: the web app (Vite), the API and the worker. `npm run infra:up` starts the services the
# defaults below point at (Postgres, Redis, Mailpit) in Docker.

# --- API and worker --------------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# The API's own role. Row-level security applies to it; it owns nothing.
DATABASE_URL=postgres://grand_app:grand_app@localhost:5432/grand
# The database owner, used only by `npm run db:migrate`.
DATABASE_MIGRATION_URL=postgres://grand:grand@localhost:5432/grand
REDIS_URL=redis://localhost:6379

# Signs access tokens. Make your own: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me

# The web app's address(es), comma-separated. Only these may use the sign-in cookie and WebSockets.
WEB_ORIGINS=http://localhost:5173
# Where links in emails point.
PUBLIC_WEB_URL=http://localhost:5173

# Email. Mailpit (from infra:up) catches everything at http://localhost:8025. In production, any
# SMTP provider works; Brevo (300 a day) and Resend (100 a day) are free.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Grand LMS <no-reply@grand.local>

# --- Web app (apps/web) ----------------------------------------------------------------------------

# Where `npm run dev:web` proxies /api/v1 (the API above).
LOCAL_API_URL=http://localhost:3000

# Keys for the video proxy (the Explore pages). Read by the Netlify function and the dev server,
# never bundled into the browser code, so they must NOT start with VITE_. Both are free.
# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials), restricted to
# "YouTube Data API v3". Without it, Explore shows Dailymotion videos instead.
YOUTUBE_API_KEY=
# A Twitch app from https://dev.twitch.tv/console (optional: without it Twitch clips are skipped).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Production builds only (set these on Netlify, not here):
# API_ORIGIN=https://grand-lms.duckdns.org     /api/v1 is proxied there
# REALTIME_ORIGIN=https://grand-lms.duckdns.org  WebSockets connect there (defaults to API_ORIGIN)
